{% extends 'base.html.twig' %}

{% block title %}Mensajes{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% endblock %}

{% block body %}
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('inicio') }}">
                    <img src="{{ asset('images/habbowallapop.gif') }}" alt="">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('inicio') }}">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('categorias') }}">Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('publicaciones') }}">Publicaciones</a>
                        </li>

                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('mensajes_lista') }}">Mensajes</a>
                            </li>
                        {% endif %}
                    </ul>

                    <div class="text-end">
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <a href="{{ path('perfil') }}" class="btn btn-outline-light me-2">Mi Perfil</a>
                            <a href="{{ path('logout') }}" class="btn btn-warning">Desconectarse</a>
                        {% else %}
                            <a href="{{ path('login') }}" class="btn btn-outline-light me-2">Login</a>
                            <a href="{{ path('registrar') }}" class="btn btn-warning">Registrarse</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
    </header>




    <div class="container py-5">
        <div class="card shadow-lg mx-auto" style="max-width: 800px;">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Mensajes sobre la publicación</h3>
                <small>{{ publicacion.descripcion }}</small>
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                {% if mensajes is not empty %}
                    {% for mensaje in mensajes %}
                        <div class="mb-3">
                            <div class="d-flex justify-content-{{ mensaje.emisor == app.user ? 'end' : 'start' }}">
                                <div class="p-3 rounded"
                                     style="
                                             max-width: 75%;
                                             background-color: {{ mensaje.emisor == app.user ? '#d4edda' : '#f1f1f1' }};
                                             color: #212529;
                                             border: 1px solid #c3e6cb;
                                             ">
                                    <strong>
                                        {{ mensaje.emisor == app.user ? 'Tú' : mensaje.emisor.nombreUsuario }}:
                                    </strong>
                                    <p class="mb-1">{{ mensaje.contenido }}</p>
                                    <small class="text-muted">{{ mensaje.fechaEnvio|date('d/m/Y H:i') }}</small>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p class="text-center">No hay mensajes aún.</p>
                {% endif %}
            </div>
            {% if hayMasMensajes %}
                <div class="card-footer text-center">
                    <p class="text-muted">Hay más mensajes disponibles...</p>
                </div>
            {% endif %}
        </div>

        <div class="card mt-4 shadow-lg mx-auto" style="max-width: 800px;">
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <textarea name="contenido" required class="form-control" rows="4" placeholder="Escribe tu mensaje aquí..."></textarea>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Enviar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
