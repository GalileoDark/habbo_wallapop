{% extends 'base.html.twig' %}

{% block title %}{{ publicacion.objeto.nombre }} - Publicación{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

{% block body %}
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('inicio') }}">
                    <img src="{{ asset('images/habbowallapop.gif') }}" alt="">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('inicio') }}">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('categorias') }}">Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('publicaciones') }}">Publicaciones</a>
                        </li>

                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('mensajes_lista') }}">Mensajes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('ver_inventario') }}">Mi Inventario</a>
                            </li>
                        {% endif %}
                    </ul>

                    <div class="text-end">
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <a href="{{ path('perfil') }}" class="btn btn-outline-light me-2">Mi Perfil</a>
                            <a href="{{ path('logout') }}" class="btn btn-warning">Desconectarse</a>
                        {% else %}
                            <a href="{{ path('login') }}" class="btn btn-outline-light me-2">Login</a>
                            <a href="{{ path('registrar') }}" class="btn btn-warning">Registrarse</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
    </header>


    <div class="container py-5">
        <div class="card shadow-sm border-0">
            <div class="row g-0">
                <div class="col-md-4 d-flex align-items-center justify-content-center p-4">
                    <img src="{{ asset('images/catalogo/' ~ publicacion.objeto.categoria.nombre ~ '/' ~ publicacion.objeto.nombre ~ '.gif') }}"
                         class="img-fluid rounded"
                         alt="{{ publicacion.objeto.nombre }}"
                         style="max-width: 200px;">
                </div>
                <div class="col-md-8">
                    <div class="card-body p-4">
                        <h2 class="card-title mb-3">{{ publicacion.objeto.nombre|replace({'_':' '}) }}</h2>
                        <p class="card-text">{{ publicacion.descripcion }}</p>
                        <ul class="list-unstyled mt-3">
                            <li><strong>Cantidad:</strong> {{ publicacion.cantidad }}</li>
                            <li><strong>Precio medio:</strong> {{ publicacion.objeto.precioMedio }} créditos</li>
                            <li><strong>Estado:</strong> {{ publicacion.estado }}</li>
                            <li><strong>Objeto que busca:</strong> {{ publicacion.buscaObjeto ? publicacion.buscaObjeto : 'se negocia' }}</li>
                        </ul>

                        <div class="mt-4 d-flex gap-3 flex-wrap">
                            <a href="{{ path('publicaciones') }}" class="btn btn-outline-dark">
                                <i class="bi bi-arrow-left-circle me-2"></i>Volver a publicaciones
                            </a>

                            {% if is_granted('IS_AUTHENTICATED_FULLY') and app.user != publicacion.usuario %}
                                <a href="{{ path('mensaje_nuevo', {'id': publicacion.usuario.id}) }}"
                                   class="btn btn-primary">
                                    <i class="bi bi-envelope-fill me-2"></i>Enviar mensaje
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
