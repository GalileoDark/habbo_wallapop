{% extends 'base.html.twig' %}

{% block title %}Registro{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">



    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Bundle JS (incluye Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- CSS de Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- jQuery (requerido por Select2) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- JS de Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            $('.select2').select2({
                width: '100%',
                placeholder: 'Selecciona un objeto',
            });
        });
    </script>

{% endblock %}



{% block body %}
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('inicio') }}">
                    <img src="{{ asset('images/habbowallapop.gif') }}" alt="">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('inicio') }}">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('categorias') }}">Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('publicaciones') }}">Publicaciones</a>
                        </li>

                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('mensajes_lista') }}">Mensajes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('ver_inventario') }}">Mi Inventario</a>
                            </li>
                        {% endif %}
                    </ul>

                    <div class="text-end">
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <a href="{{ path('perfil') }}" class="btn btn-outline-light me-2">Mi Perfil</a>
                            <a href="{{ path('logout') }}" class="btn btn-warning">Desconectarse</a>
                        {% else %}
                            <a href="{{ path('login') }}" class="btn btn-outline-light me-2">Login</a>
                            <a href="{{ path('registrar') }}" class="btn btn-warning">Registrarse</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
    </header>





    <div class="container-fluid d-flex justify-content-center align-items-center min-vh-100">
        <div class="row justify-content-center w-100">
            <div class="col-md-6">
                <!-- Recuadro del formulario -->
                <div class="card shadow-sm rounded-lg p-4 bg-light">
                    <h1 class="text-center mb-4"><img src="{{ asset('images/crear_publicacion.gif') }}"></h1>

                    {{ form_start(form, {'attr': {'class': 'form-publicacion'}}) }}

                    <div class="mb-3">
                        {{ form_label(form.descripcion, 'Descripción', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.descripcion, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.descripcion) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.buscaObjeto, 'Objeto buscado (opcional)', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.buscaObjeto, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.buscaObjeto) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.cantidad, 'Cantidad', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.cantidad, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.cantidad) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.estado, 'Estado', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.estado, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.estado) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.objeto, 'Objeto ofrecido', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.objeto, {'attr': {'class': 'form-control select2'}}) }}
                        {{ form_errors(form.objeto) }}
                    </div>

                    <div class="text-center">
                        <button class="btn btn-success w-100" type="submit">Publicar</button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
