{% extends 'base.html.twig' %}

{% block title %}Todas las Publicaciones{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Bundle JS (incluye Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


{% endblock %}

{% block body %}
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('inicio') }}">
                    <img src="{{ asset('images/habbowallapop.gif') }}" alt="">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('inicio') }}">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('categorias') }}">Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('publicaciones') }}">Publicaciones</a>
                        </li>

                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('mensajes_lista') }}">Mensajes</a>
                            </li>
                        {% endif %}
                    </ul>

                    <div class="text-end">
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <a href="{{ path('perfil') }}" class="btn btn-outline-light me-2">Mi Perfil</a>
                            <a href="{{ path('logout') }}" class="btn btn-warning">Desconectarse</a>
                        {% else %}
                            <a href="{{ path('login') }}" class="btn btn-outline-light me-2">Login</a>
                            <a href="{{ path('registrar') }}" class="btn btn-warning">Registrarse</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
    </header>


    <div class="container mt-5">
        <h1 class="text-center mb-4"><img src="{{ asset('images/todas_las_publicaciones.gif') }}"></h1>

        <div class="mb-4 text-start">
            <a href="{{ path('publicacion_nueva') }}" class="btn btn-success px-4 py-2">
                <i class="bi bi-plus-circle me-2"></i>Crear publicación
            </a>
        </div>

        {% if publicaciones is empty %}
            <div class="alert alert-info text-center">No hay publicaciones disponibles.</div>
        {% else %}
            <div id="publicaciones-container" class="d-flex flex-column gap-4">
                {% include 'publicacion/_publicacion_card.twig' with {'publicaciones': publicaciones} %}
            </div>

            {% if publicaciones|length == 3 %}
                <div class="text-center mt-4">
                    <button id="ver-mas-btn" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-arrow-down-circle me-2"></i>Ver siguientes
                    </button>
                </div>
            {% endif %}
        {% endif %}
    </div>

    <script>
        let pagina = 2;

        document.getElementById('ver-mas-btn')?.addEventListener('click', function () {
            fetch(`/cargar-publicaciones?page=${pagina}`)
                .then(response => response.text())
                .then(html => {
                    const container = document.getElementById('publicaciones-container');
                    container.insertAdjacentHTML('beforeend', html);
                    pagina++;

                    if (html.trim() === '') {
                        document.getElementById('ver-mas-btn').remove();
                    }
                })
                .catch(error => console.error('Error al cargar publicaciones:', error));
        });
    </script>
{% endblock %}
