<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">

    {# Bloque para añadir cosas al <head> desde otros templates #}
    {% block head %}

    {% endblock %}
    {% block css %}

    {% endblock %}

    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">

    {# CSS de Symfony Encore #}
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body>
{% block body %}{% endblock %}

{# JS de Symfony Encore #}
{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}
</body>
</html>
