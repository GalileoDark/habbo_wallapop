{% extends 'base.html.twig' %}

{% block title %}Mi Perfil{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Bundle JS (incluye Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


{% endblock %}

{% block body %}
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('inicio') }}">
                    <img src="{{ asset('images/habbowallapop.gif') }}" alt="">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('inicio') }}">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('categorias') }}">Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('publicaciones') }}">Publicaciones</a>
                        </li>

                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('mensajes_lista') }}">Mensajes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('ver_inventario') }}">Mi Inventario</a>
                            </li>
                        {% endif %}
                    </ul>

                    <div class="text-end">
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <a href="{{ path('perfil') }}" class="btn btn-outline-light me-2">Mi Perfil</a>
                            <a href="{{ path('logout') }}" class="btn btn-warning">Desconectarse</a>
                        {% else %}
                            <a href="{{ path('login') }}" class="btn btn-outline-light me-2">Login</a>
                            <a href="{{ path('registrar') }}" class="btn btn-warning">Registrarse</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-5 d-flex justify-content-center">
        <div class="bg-white p-4 border rounded shadow-sm" style="min-width: 60vw;">
            <h2 class="mb-4">Hola {{ usuario.nombreUsuario }}!</h2>

            <div class="row">
                <!-- Información del perfil -->
                <div class="col-md-8">
                    <p><strong>ID:</strong> {{ usuario.id }}</p>
                    <p><strong>Email:</strong> {{ usuario.email }}</p>
                    <p><strong>País:</strong> {{ usuario.pais }}</p>
                    <p><strong>Descripción:</strong> {{ usuario.descripcion }}</p>
                </div>

                <!-- Foto de perfil -->
                <div class="col-md-4 text-center">
                    <h5 class="mb-3">Foto de perfil</h5>
                    <img src="{{ asset('images/perfil/' ~ usuario.fotoPerfil) }}" alt="Foto de perfil" width="150" class="rounded shadow-sm">
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <a href="{{ path('perfil_editar') }}" class="btn btn-primary">Modificar perfil</a>
                <a href="{{ path('logout') }}" class="btn btn-outline-danger">Cerrar sesión</a>
            </div>
        </div>
    </div>
{% endblock %}
