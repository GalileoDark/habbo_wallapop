{% extends 'base.html.twig' %}

{% block title %}Tu Inventario{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

{% block body %}
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('inicio') }}">
                    <img src="{{ asset('images/habbowallapop.gif') }}" alt="">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item"><a class="nav-link" href="{{ path('inicio') }}">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('categorias') }}">Catálogo</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('publicaciones') }}">Publicaciones</a></li>

                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li class="nav-item"><a class="nav-link" href="{{ path('mensajes_lista') }}">Mensajes</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('ver_inventario') }}">Mi Inventario</a></li>
                        {% endif %}
                    </ul>

                    <div class="text-end">
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <a href="{{ path('perfil') }}" class="btn btn-outline-light me-2">Mi Perfil</a>
                            <a href="{{ path('logout') }}" class="btn btn-warning">Desconectarse</a>
                        {% else %}
                            <a href="{{ path('login') }}" class="btn btn-outline-light me-2">Login</a>
                            <a href="{{ path('registrar') }}" class="btn btn-warning">Registrarse</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-5">
        <div class="main-container mx-auto p-4 rounded bg-light" style="max-width: 1200px;">
            <h2 class="mb-4">Inventario de {{ app.user.username }}</h2>

            {% if inventario is not empty %}
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    {% for entrada in inventario %}
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <img src="{{ asset('images/catalogo/' ~ entrada.objeto.categoria.nombre ~ '/' ~ entrada.objeto.nombre ~ '.gif') }}"
                                     class="card-img-top p-3"
                                     alt="{{ entrada.objeto.nombre }}"
                                     style="height: 180px; object-fit: contain;">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">{{ entrada.objeto.nombre|replace({'_': ' '}) }}</h5>
                                    <p class="card-text flex-grow-1">{{ entrada.objeto.descripcion }}</p>
                                    <p class="card-text"><strong>Cantidad en inventario:</strong> {{ entrada.cantidad }}</p>

                                    <div class="d-flex justify-content-between mt-3">
                                        <form method="post" action="{{ path('inventario_add', {'id': entrada.objeto.id}) }}">
                                            <button type="submit" class="btn btn-success">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </form>

                                        <form method="post" action="{{ path('inventario_remove', {'id': entrada.objeto.id}) }}">
                                            <button type="submit" class="btn btn-danger">
                                                <i class="bi bi-dash-lg"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p>No tienes objetos en tu inventario.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
