{% extends 'base.html.twig' %}

{% block title %}Inicio{% endblock %}
{% block head %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Bundle JS (incluye Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
{% block body %}
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">HabboWallapop</a>

                <!-- Botón hamburguesa -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Contenido del menú -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="#">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Categorías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Publicaciones</a>
                        </li>
                    </ul>

                    <!-- Botones de login/registro -->
                    <div class="text-end">
                        <a href="#" class="btn btn-outline-light me-2">Login</a>
                        <a href="#" class="btn btn-warning">Registrarse</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <h1>Página de inicio</h1>

    <div class="grid-container">
        <div class="titulo-media">
            <h2>Objetos con mayor subida de precio</h2>
            <div class="media-precios">
                <div class="objeto">1</div>
                <div class="objeto">2</div>
                <div class="objeto">3</div>
                <div class="objeto">4</div>
                <div class="objeto">5</div>
            </div>
        </div>

        <!-- 5 bloques de publicaciones -->
        <div class="publicacion">Publicación 1</div>
        <div class="publicacion">Publicación 2</div>
        <div class="publicacion">Publicación 3</div>
        <div class="publicacion">Publicación 4</div>
        <div class="publicacion">Publicación 5</div>
    </div>
{% endblock %}
