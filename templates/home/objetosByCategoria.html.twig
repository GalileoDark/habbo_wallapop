{% extends 'base.html.twig' %}

{% block title %}Catálogo de Objetos{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

{% block body %}
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('inicio') }}">
                    <img src="{{ asset('images/habbowallapop.gif') }}" alt="">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('inicio') }}">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('categorias') }}">Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('publicaciones') }}">Publicaciones</a>
                        </li>

                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('mensajes_lista') }}">Mensajes</a>
                            </li>
                        {% endif %}
                    </ul>

                    <div class="text-end">
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <a href="{{ path('perfil') }}" class="btn btn-outline-light me-2">Mi Perfil</a>
                            <a href="{{ path('logout') }}" class="btn btn-warning">Desconectarse</a>
                        {% else %}
                            <a href="{{ path('login') }}" class="btn btn-outline-light me-2">Login</a>
                            <a href="{{ path('registrar') }}" class="btn btn-warning">Registrarse</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
    </header>



    <div class="container my-5">
        <div class="main-container mx-auto p-4 rounded bg-light" style="max-width: 1200px;">
            <!-- Banner -->
            <img src="{{ asset('images/catalogo/' ~ categoriaNombre ~ '/banner.gif') }}" alt="Banner del catálogo" class="img-fluid rounded mb-4">

            {% if objetos is not empty %}
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    {% for item in objetos %}
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <img src="{{ asset('images/catalogo/' ~ categoriaNombre ~ '/'~ item.nombre ~'.gif') }}" class="card-img-top p-3" alt="{{ item.nombre }}" style="height: 180px; object-fit: contain;">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">{{ item.nombre|replace({'_':' '}) }}</h5>
                                    <p class="card-text flex-grow-1">{{ item.descripcion }}</p>
                                    <ul class="list-group list-group-flush mb-3">
                                        <li class="list-group-item"><strong>Precio Catálogo:</strong> {{ item.precioCatalogo }}</li>
                                        <li class="list-group-item"><strong>Precio Medio:</strong> {{ item.precioMedio }}</li>
                                        <li class="list-group-item"><strong>Fecha Salida:</strong> {{ item.fechaSalida ? item.fechaSalida|date('d-m-Y') : '—' }}</li>
                                    </ul>
                                    <a href="#" class="btn btn-primary mt-auto">Ver detalles</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p>No se encontraron objetos.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
