{% extends 'base.html.twig' %}

{% block title %}Estudiantes{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    </style>

    <div class="example-wrapper">
        <h1>categorias</h1>
        <table border="1">
            <tr>
                <td>Nombre</td>
                <td>Descripcion</td>
                <td>Precio Catalogo</td>
                <td>Precio media</td>
                <td>Fecha Salida</td>
            </tr>
            {% for item in objetos %}
                <tr>
                    <td>{{ item.nombre }}</td>
                    <td>{{ item.descripcion }}</td>
                    <td>{{ item.precioCatalogo }}</td>
                    <td>{{ item.precioMedio }}</td>
                    <td>{{ item.fechaSalida|date ('d-m-Y') }}</td>
                </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}
